# Скопировать в /etc/ledger/ledger.env (root, chmod 600) и заполнить. В git — только этот пример.
# Подключение в скриптах: set -a; . /etc/ledger/ledger.env; set +a
LEDGER_BYBIT_API_KEY=
LEDGER_BYBIT_API_SECRET=
LEDGER_HUB_AGENT_KEY=
LEDGER_HUB_BASE_URL=https://hub.gosling-agency.ru
# Свой ключ хаба ledger только с правом introspect:agent_keys: без него ключи агентов хаба ledger не принимает.
LEDGER_HUB_INTROSPECT_KEY=
LEDGER_VOLUME=ledger_data
# Нужны только при первой установке; дальше их берут из deploy/.runtime/current.json.
LEDGER_IMAGE=ledger:local
LEDGER_BUILD=local
LEDGER_DEPLOYMENT=local-initial
LITESTREAM_REPLICA_URL=file:///data/replica/ledger
